# This Makefile allows to compile the paper in a temp dir, to avoid syncing autogenerated files in Dropbox.

PAPER = article

BIBFILE = references.bib
BSTFILE = sn-mathphys.bst

CURDIR = "$(shell pwd)"
OUTDIR = /tmp/swipe-thesis

all: dirs paper bib
	$(MAKE) bib
	$(MAKE) paper

dirs:
	mkdir -p $(OUTDIR)

paper: $(wildcard *.tex)
	pdflatex -output-directory $(OUTDIR) $(PAPER).tex

bib: paper
	cd $(OUTDIR); ln -sf $(CURDIR)/$(BIBFILE) .; \
	              ln -sf $(CURDIR)/$(BSTFILE) .; \
	              bibtex $(PAPER).aux; \
	              cd -

clean: dirs
	cd $(OUTDIR); rm -f *.log *.blg *.bbl *.out *.aux \
	                    *.bcf *.toc *.spl *.tpt *.synctex.gz *.run.xml; \
	              cd -
