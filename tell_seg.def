Bootstrap: docker
From: pytorch/pytorch:2.3.0-cuda12.1-cudnn8-runtime

%post
    # Create essential directories the container needs
    mkdir -p /dev /proc /sys /tmp /workspace /data

    apt-get update && apt-get install -y --no-install-recommends \
        git \
        libglib2.0-0 \
        libgl1-mesa-glx \
        && apt-get clean && rm -rf /var/lib/apt/lists/*

    pip install --no-cache-dir \
        "segmentation-models-pytorch==0.5.0" \
        "albumentations>=1.3.0" \
        "torchmetrics>=1.5.0" \
        "wandb>=0.15.0" \
        "scikit-learn>=1.2.0" \
        "pytorch-lightning>=2.4.0" \
        "timm>=1.0.0" \
	"matplotlib>=3.7.0" \
	"ray[tune]>=2.10.0" \
	"optuna>=3.14.0"

%environment
    export PYTHONNOUSERSITE=1
    export PYTHONUNBUFFERED=1

%labels
    Author nahsan
    Description Tell site segmentation environment
    PyTorch 2.3.0
    CUDA 12.1

%runscript
    exec python "$@"
