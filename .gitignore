!images/agreement-field-systems.png
!images/agreement-arid-margin.png

# Local run outputs: PADS defaults PROJECT_ROOT to <repo>/runs so logs and
# checkpoints stay out of the baseline deeplab/ and segformer/ source dirs.
runs/

# PADS 'stage' policy staging area (local runs)
scratch/
*.db

